{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/server.cjs"
    },
    {
      "source": "/(.*)",
      "destination": "/$1",
      "continue": true
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "backend/server.cjs": {
      "runtime": "vercel-node@latest",
      "includeFiles": "backend/**"
    }
  }
}
