{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/server.cjs"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "backend/server.cjs": {
      "runtime": "vercel-node@latest",
      "includeFiles": "backend/**"
    }
  }
}
